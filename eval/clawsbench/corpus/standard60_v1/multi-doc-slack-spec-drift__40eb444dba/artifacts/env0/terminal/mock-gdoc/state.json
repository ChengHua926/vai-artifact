{"users":{"user_alex":{"user":{"id":"user_alex","email":"alex@nexusai.com","displayName":"Alex Chen"},"documents":[{"id":"1ApiRateLimitingPolicySpec000000000000000000","title":"API Rate Limiting Policy","body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":51,"paragraph":{"elements":[{"startIndex":1,"endIndex":51,"textRun":{"content":"API Rate Limiting Policy\n========================\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":51,"endIndex":202,"paragraph":{"elements":[{"startIndex":51,"endIndex":202,"textRun":{"content":"\nOverview\n--------\nThis document defines the rate limiting policy for all public API\nendpoints. Rate limits are enforced per API key and vary by tier.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":202,"endIndex":333,"paragraph":{"elements":[{"startIndex":202,"endIndex":333,"textRun":{"content":"\nRate Limits by Tier\n-------------------\n- Free: 100 requests/minute\n- Pro: 500 requests/minute\n- Enterprise: 1000 requests/minute\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":333,"endIndex":601,"paragraph":{"elements":[{"startIndex":333,"endIndex":601,"textRun":{"content":"\nResponse Headers\n----------------\nAll rate-limited responses include the following headers:\n- X-RateLimit-Limit: maximum requests per window\n- X-RateLimit-Remaining: requests remaining in current window\n- X-RateLimit-Reset: UTC epoch timestamp when the window resets\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":601,"endIndex":807,"paragraph":{"elements":[{"startIndex":601,"endIndex":807,"textRun":{"content":"\nBurst Policy\n------------\nClients may temporarily exceed their per-minute limit within a\n60-second burst window. Burst capacity is 2x the tier limit.\nAfter the burst window expires, standard limits apply.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":807,"endIndex":1002,"paragraph":{"elements":[{"startIndex":807,"endIndex":1002,"textRun":{"content":"\nError Handling\n--------------\nWhen a client exceeds the rate limit, the API returns HTTP 429\nToo Many Requests with a JSON body:\n  {\"error\": \"rate_limit_exceeded\", \"retry_after_seconds\": <int>}\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1002,"endIndex":1150,"paragraph":{"elements":[{"startIndex":1002,"endIndex":1150,"textRun":{"content":"\nRevision History\n----------------\n- 2026-01-15: Initial draft\n- 2026-02-10: Added burst policy section\n- 2026-03-01: Updated error response format\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"documentStyle":{},"namedStyles":{},"lists":{},"inlineObjects":{},"headers":{},"footers":{},"footnotes":{},"namedRanges":{},"positionedObjects":{},"revisionId":"deafc545","suggestionsViewMode":"DEFAULT_FOR_CURRENT_ACCESS","createdTime":"2025-12-23T05:23:49.104961","modifiedTime":"2026-02-17T05:23:49.104961"},{"id":"f66bd908c11742f9977b30a97b36290e","title":"API Authentication Guide","body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":26,"paragraph":{"elements":[{"startIndex":1,"endIndex":26,"textRun":{"content":"API Authentication Guide\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":26,"endIndex":135,"paragraph":{"elements":[{"startIndex":26,"endIndex":135,"textRun":{"content":"\nAll API requests require Bearer token authentication.\nTokens