diff --git a/src/agents/tool-observation.ts b/src/agents/tool-observation.ts
new file mode 100644
index 0000000000..b24d366ed8
--- /dev/null
+++ b/src/agents/tool-observation.ts
@@ -0,0 +1,121 @@
+/** Observation only: native approval decisions and execution keep their existing owners. */
+import { AsyncLocalStorage } from "node:async_hooks";
+import { getGlobalHookRunner } from "../plugins/hook-runner-global.js";
+import type {
+  PluginHookToolContext,
+  PluginHookToolObservationEvent,
+} from "../plugins/hook-types.js";
+
+type Invocation = {
+  actionId: string;
+  toolName: string;
+  toolCallId: string;
+  params: Record<string, unknown>;
+  ctx: PluginHookToolContext;
+  completed: boolean;
+  dispatched: boolean;
+  nonexecutionCode?: string;
+};
+const invocation = new AsyncLocalStorage<Invocation>();
+type ApprovalObservation = Pick<
+  PluginHookToolObservationEvent,
+  "phase" | "requestId" | "decision" | "scope" | "authority" | "policyId" | "origin"
+>;
+
+async function emit(
+  fields: Partial<PluginHookToolObservationEvent> & {
+    phase: PluginHookToolObservationEvent["phase"];
+  },
+) {
+  const current = invocation.getStore();
+  const hooks = getGlobalHookRunner();
+  if (!current || !hooks?.hasHooks("tool_observation")) return;
+  await hooks.runToolObservation(
+    {
+      toolName: current.toolName,
+      toolCallId: current.toolCallId,
+      params: structuredClone(current.params),
+      actionId: current.actionId,
+      eventId: `${current.actionId}:${fields.phase}:${fields.requestId ?? ""}`,
+      ...fields,
+    },
+    current.ctx,
+  );
+}
+export function isToolObservationActive() {
+  return invocation.getStore() !== undefined;
+}
+export async function observeToolApproval(event: ApprovalObservation) {
+  await emit(event);
+}
+export function setObservedToolParams(params: unknown, dispatched = false) {
+  const current = invocation.getStore();
+  if (current && params && typeof params === "object" && !Array.isArray(params)) {
+    current.params = structuredClone(params as Record<string, unknown>);
+    current.dispatched ||= dispatched;
+  }
+}
+export function markObservedExecPreflight() {
+  const current = invocation.getStore();
+  if (current) {
+    current.dispatched = false;
+    current.nonexecutionCode = "exec-prelaunch";
+  }
+}
+export function markObservedExecSpawn() {
+  const current = invocation.getStore();
+  if (current) current.dispatched = true;
+}
+export async function completeObservedTool(result: unknown) {
+  const current = invocation.getStore();
+  if (!current || current.completed) return;
+  current.completed = true;
+  await emit({ phase: "execution_completed", result });
+}
+export async function withToolObservation<T>(
+  params: {
+    toolName: string;
+    toolCallId: string;
+    params: unknown;
+    ctx?: Omit<PluginHookToolContext, "toolName">;
+  },
+  execute: () => Promise<T>,
+): Promise<T> {
+  const nativeSession = params.ctx?.sessionId ?? params.ctx?.sessionKey;
+  if (!nativeSession || !params.toolCallId || !getGlobalHookRunner()?.hasHooks("tool_observation"))
+    return execute();
+  const state: Invocation = {
+    actionId: JSON.stringify([nativeSession, params.ctx?.runId ?? "", params.toolCallId]),
+    toolName: params.toolName,
+    toolCallId: params.toolCallId,
+    params: structuredClone(params.params as Record<string, unknown>),
+    ctx: { ...params.ctx, toolName: params.toolName, toolCallId: params.toolCallId },
+    completed: false,
+    dispatched: false,
+  };
+  return invocation.run(state, async () => {
+    await emit({ phase: "execution_started" });
+    try {
+      const result = await execute();
+      const status = (result as { details?: { status?: string } })?.details?.status;
+      // A pending approval or background process owns its later terminal event.
+      if (status !== "approval-pending" && status !== "running") {
+        await completeObservedTool(
+          status === "blocked" || status === "denied" ? { blocked: result } : result,
+        );
+      }
+      return result;
+    } catch (error) {
+      await completeObservedTool(
+        state.dispatched
+          ? { error: String(error) }
+          : {
+              blocked: state.nonexecutionCode
+                ? { code: state.nonexecutionCode, message: String(error) }
+                : String(error),
+            },
+      );
+      throw error;
+    }
+  });
+}
diff --git a/src/agents/tool-observation.test.ts b/src/agents/tool-observation.test.ts
new file mode 100644
index 0000000000..1b03f5eb9b
--- /dev/null
+++ b/src/agents/tool-observation.test.ts
@@ -0,0 +1,158 @@
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  initializeGlobalHookRunner,
+  resetGlobalHookRunner,
+} from "../plugins/hook-runner-global.js";
+import type {
+  PluginHookToolObservationEvent,
+  PluginHookToolContext,
+} from "../plugins/hook-types.js";
+import { createMockPluginRegistry } from "../plugins/hooks.test-helpers.js";
+import {
+  withToolObservation,
+  observeToolApproval,
+  completeObservedTool,
+  markObservedExecPreflight,
+  markObservedExecSpawn,
+} from "./tool-observation.js";
+
+afterEach(resetGlobalHookRunner);
+describe("native tool observation", () => {
+  it("keeps invocation identity across deferred completion and concurrent sessions", async () => {
+    const events: Array<{
+      phase: string;
+      actionId: string;
+      decision?: string | null;
+      sessionId?: string;
+    }> = [];
+    initializeGlobalHookRunner(
+      createMockPluginRegistry([
+        {
+          hookName: "tool_observation",
+          handler: async (e, c) => {
+            events.push({
+              ...(e as PluginHookToolObservationEvent),
+              sessionId: (c as PluginHookToolContext).sessionId,
+            });
+          },
+        },
+      ]),
+    );
+    let resolveApproval!: () => void;
+    let terminal!: Promise<void>;
+    const decision = new Promise<void>((resolve) => {
+      resolveApproval = resolve;
+    });
+    await withToolObservation(
+      {
+        toolName: "exec",
+        toolCallId: "same",
+        params: { command: "printf one" },
+        ctx: { sessionId: "one", runId: "r" },
+      },
+      async () => {
+        await observeToolApproval({ phase: "approval_requested", requestId: "q" });
+        terminal = (async () => {
+          await decision;
+          await observeToolApproval({
+            phase: "approval_resolved",
+            requestId: "q",
+            decision: "allow-once",
+            scope: "once",
+            authority: "human",
+          });
+          await completeObservedTool({ ok: true });
+        })();
+        return { details: { status: "approval-pending" } };
+      },
+    );
+    await withToolObservation(
+      {
+        toolName: "exec",
+        toolCallId: "same",
+        params: { command: "printf two" },
+        ctx: { sessionId: "two", runId: "r" },
+      },
+      async () => ({ ok: true }),
+    );
+    expect(events.filter((e) => e.sessionId === "one").map((e) => e.phase)).toEqual([
+      "execution_started",
+      "approval_requested",
+    ]);
+    expect(events.filter((e) => e.sessionId === "two").map((e) => e.phase)).toEqual([
+      "execution_started",
+      "execution_completed",
+    ]);
+    resolveApproval();
+    await terminal;
+    expect(events.filter((e) => e.sessionId === "one").map((e) => e.phase)).toEqual([
+      "execution_started",
+      "approval_requested",
+      "approval_resolved",
+      "execution_completed",
+    ]);
+    expect(new Set(events.filter((e) => e.sessionId === "one").map((e) => e.actionId)).size).toBe(
+      1,
+    );
+  });
+  it("emits an exact allow-once decision before completion, without turning timeout into allow", async () => {
+    const events: unknown[] = [];
+    initializeGlobalHookRunner(
+      createMockPluginRegistry([
+        {
+          hookName: "tool_observation",
+          handler: async (e) => {
+            events.push(e);
+          },
+        },
+      ]),
+    );
+    await withToolObservation(
+      { toolName: "write", toolCallId: "c", params: { path: "target" }, ctx: { sessionId: "s" } },
+      async () => {
+        await observeToolApproval({
+          phase: "approval_resolved",
+          requestId: "q",
+          decision: "allow-once",
+          scope: "once",
+          authority: "human",
+        });
+        return { ok: true };
+      },
+    );
+    expect(events).toMatchObject([
+      { phase: "execution_started" },
+      { phase: "approval_resolved", decision: "allow-once", params: { path: "target" } },
+      { phase: "execution_completed", result: { ok: true } },
+    ]);
+  });
+  it("keeps failures after native process dispatch accountable", async () => {
+    const events: PluginHookToolObservationEvent[] = [];
+    initializeGlobalHookRunner(
+      createMockPluginRegistry([
+        {
+          hookName: "tool_observation",
+          handler: async (event) => {
+            events.push(event as PluginHookToolObservationEvent);
+          },
+        },
+      ]),
+    );
+    await expect(
+      withToolObservation(
+        {
+          toolName: "exec",
+          toolCallId: "failed",
+          params: { command: "exit 7" },
+          ctx: { sessionId: "s" },
+        },
+        async () => {
+          markObservedExecPreflight();
+          markObservedExecSpawn();
+          throw new Error("process exited with code 7");
+        },
+      ),
+    ).rejects.toThrow("process exited");
+    expect(events.at(-1)?.result).toEqual({ error: "Error: process exited with code 7" });
+  });
+});
diff --git a/src/agents/aa-accountability.seam.e2e.test.ts b/src/agents/aa-accountability.seam.e2e.test.ts
new file mode 100644
index 0000000000..3acad02706
--- /dev/null
+++ b/src/agents/aa-accountability.seam.e2e.test.ts
@@ -0,0 +1,144 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  initializeGlobalHookRunner,
+  resetGlobalHookRunner,
+} from "../plugins/hook-runner-global.js";
+import type { PluginHookToolObservationEvent } from "../plugins/hook-types.js";
+import { createMockPluginRegistry } from "../plugins/hooks.test-helpers.js";
+import { wrapToolWithBeforeToolCallHook } from "./agent-tools.before-tool-call.js";
+import { createExecTool } from "./bash-tools.exec.js";
+import type { AnyAgentTool } from "./tools/common.js";
+
+const gateway = vi.hoisted(() => vi.fn());
+vi.mock("./tools/gateway.js", () => ({ callGatewayTool: gateway }));
+
+describe("accountability observations from native generic approval dispatch", () => {
+  let events: PluginHookToolObservationEvent[];
+  beforeEach(() => {
+    events = [];
+    gateway.mockReset();
+    initializeGlobalHookRunner(
+      createMockPluginRegistry([
+        {
+          hookName: "before_tool_call",
+          pluginId: "approval-policy",
+          handler: async () => ({
+            requireApproval: { title: "Write", description: "Allow this write?" },
+          }),
+        },
+        {
+          hookName: "tool_observation",
+          handler: async (event) => {
+            events.push(event as PluginHookToolObservationEvent);
+          },
+        },
+      ]),
+    );
+  });
+  afterEach(resetGlobalHookRunner);
+  it.each(["allow-once", "allow-always", "deny", null])(
+    "records native decision %s and only runs allowed effects",
+    async (decision) => {
+      gateway.mockResolvedValueOnce({ id: "q1" }).mockResolvedValueOnce({ id: "q1", decision });
+      const effects: unknown[] = [];
+      const tool = wrapToolWithBeforeToolCallHook(
+        {
+          name: "write",
+          execute: async (_id: string, args: unknown) => {
+            effects.push(args);
+            return { content: [], details: { ok: true } };
+          },
+        } as AnyAgentTool,
+        { sessionId: "native-s1", runId: "r1" },
+        { emitDiagnostics: false },
+      );
+      try {
+        await tool.execute(
+          "call1",
+          { path: "workspace/a", content: "hello" },
+          undefined,
+          undefined,
+        );
+      } catch {
+        /* native denial is an error result */
+      }
+      const allowed = decision === "allow-once" || decision === "allow-always";
+      expect(effects).toHaveLength(allowed ? 1 : 0);
+      expect(events.map((e) => e.phase)).toEqual([
+        "execution_started",
+        "approval_requested",
+        "approval_resolved",
+        "execution_completed",
+      ]);
+      expect(events[2]).toMatchObject({
+        requestId: "q1",
+        decision: decision ?? "timeout",
+        scope: decision === "allow-always" ? "persistent" : "once",
+        authority: "human",
+        params: { path: "workspace/a", content: "hello" },
+      });
+      expect(new Set(events.map((e) => e.actionId)).size).toBe(1);
+      if (!allowed) expect(events[3].result).toHaveProperty("blocked");
+    },
+  );
+});
+
+describe("native exec prelaunch nonexecution", () => {
+  afterEach(resetGlobalHookRunner);
+  it.each(["security", "input", "elevation", "host", "node"])(
+    "records %s refusal without executing or fabricating an effect",
+    async (kind) => {
+      const events: PluginHookToolObservationEvent[] = [];
+      gateway.mockReset();
+      initializeGlobalHookRunner(
+        createMockPluginRegistry([
+          {
+            hookName: "tool_observation",
+            handler: async (event) => {
+              events.push(event as PluginHookToolObservationEvent);
+            },
+          },
+        ]),
+      );
+      const dir = fs.mkdtempSync(path.join(os.tmpdir(), "aa-refused-"));
+      try {
+        const target = path.join(dir, "effect");
+        const tool = wrapToolWithBeforeToolCallHook(
+          createExecTool({
+            host: kind === "node" ? "node" : "gateway",
+            security: kind === "security" ? "deny" : "full",
+            ask: "off",
+            cwd: dir,
+          }),
+          { sessionId: `refused-${kind}`, runId: "r" },
+          { emitDiagnostics: false },
+        );
+        const args =
+          kind === "input"
+            ? {}
+            : {
+                command: `printf attempted > ${target}`,
+                ...(kind === "elevation" ? { elevated: true } : {}),
+                ...(kind === "host" ? { host: "invalid-host" } : {}),
+              };
+        await expect(tool.execute(`call-${kind}`, args, undefined, undefined)).rejects.toThrow();
+        expect(fs.existsSync(target)).toBe(false);
+        expect(gateway).not.toHaveBeenCalled();
+        expect(events.map((e) => e.phase)).toEqual(["execution_started", "execution_completed"]);
+        expect(events.at(-1)?.result).toMatchObject({
+          blocked: { code: kind === "node" ? "unsupported-exec-host" : "exec-prelaunch" },
+        });
+        if (process.env.AA_TEST_OBSERVATIONS)
+          fs.appendFileSync(
+            process.env.AA_TEST_OBSERVATIONS,
+            JSON.stringify({ native_session_id: `refused-${kind}`, events }) + "\n",
+          );
+      } finally {
+        fs.rmSync(dir, { recursive: true, force: true });
+      }
+    },
+  );
+});
