{"added":{},"updated":{"user_alex":{"documents":{"added":[],"updated":[{"id":"1xY2zA3bC4dE5fG6hI7jK8lM9nO0pQ1rS2tU3vW4xY5z","body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":27,"paragraph":{"elements":[{"startIndex":1,"endIndex":27,"textRun":{"content":"Vendor Services Agreement\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":27,"endIndex":116,"paragraph":{"elements":[{"startIndex":27,"endIndex":116,"textRun":{"content":"\nThis agreement is between Meridian Labs (\"Company\") and CloudPeak Solutions (\"Vendor\").\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":116,"endIndex":270,"paragraph":{"elements":[{"startIndex":116,"endIndex":270,"textRun":{"content":"\n1. Scope of Services\nCloudPeak Solutions shall provide cloud infrastructure services to Meridian Labs for a period of 12 months beginning April 1, 2026.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":270,"endIndex":365,"paragraph":{"elements":[{"startIndex":270,"endIndex":365,"textRun":{"content":"\n2. Payment Terms\nMeridian Labs agrees to pay $15,000/month for the services described herein.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":365,"endIndex":501,"paragraph":{"elements":[{"startIndex":365,"endIndex":501,"textRun":{"content":"\n3. Confidentiality\nBoth Meridian Labs and CloudPeak Solutions agree to maintain confidentiality of all shared proprietary information.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":501,"endIndex":542,"paragraph":{"elements":[{"startIndex":501,"endIndex":542,"textRun":{"content":"\nSigned: Legal Department, Meridian Labs\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"revisionId":"4447413f","modifiedTime":"2026-07-20T05:40:35.356347"},{"id":"1zA4bC5dE6fG7hI8jK9lM0nO1pQ2rS3tU4vW5xY6zA7b","body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":19,"paragraph":{"elements":[{"startIndex":1,"endIndex":19,"textRun":{"content":"About Our Company\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":19,"endIndex":169,"paragraph":{"elements":[{"startIndex":19,"endIndex":169,"textRun":{"content":"\nMeridian Labs is a leading artificial intelligence company founded in 2022. Our mission at Meridian Labs is to make AI accessible to every business.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":169,"endIndex":248,"paragraph":{"elements":[{"startIndex":169,"endIndex":248,"textRun":{"content":"\nTeam:\n- CEO: Sarah Chen\n- CTO: Marcus Johnson\n- VP Engineering: Alex Thompson\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":248,"endIndex":310,"paragraph":{"elements":[{"startIndex":248,"endIndex":310,"textRun":{"content":"\nMeridian Labs is headquartered in San Francisco, California.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":310,"endIndex":337,"paragraph":{"elements":[{"startIndex":310,"endIndex":337,"textRun":{"content":"\nContact: info@nexusai.com\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]},"revisionId":"7d7a232e","modifiedTime":"2026-07-20T05:40:35.348025"},{"id":"1bC6dE7fG8hI9jK0lM1nO2pQ3rS4tU5vW6xY7zA8bC9d","body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSe